rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust security & RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "mcromeyox@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == "SUPER_ADMIN")
      );
    }

    function isSupportAgent() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         getUserData().role == "SUPPORT_AGENT")
      );
    }

    function isDriver() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == "DRIVER"
      );
    }

    function isMerchant() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == "RESTAURANT_OWNER"
      );
    }

    // --- USERS COLLECTION ---
    match /users/{userId} {
      // Users can read and write their own profile; Super Admin can read and update all
      allow read: if isOwner(userId) || isSuperAdmin() || isSupportAgent();
      allow create: if isAuthenticated() && (
        // Regular registration cannot assign SUPER_ADMIN or SUPPORT_AGENT role to self
        isOwner(userId) &&
        request.resource.data.role in ["CUSTOMER", "DRIVER", "RESTAURANT_OWNER"] &&
        (request.resource.data.role != "CUSTOMER" ? request.resource.data.status == "PENDING_APPROVAL" : true)
      ) || isSuperAdmin();

      // Users cannot change their own role or status to ACTIVE; only admin can approve
      allow update: if isSuperAdmin() || (
        isOwner(userId) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.status == resource.data.status
      );
      allow delete: if isSuperAdmin();
    }

    // --- ORDERS COLLECTION ---
    match /orders/{orderId} {
      // Orders: accessible to order owner, assigned courier, merchant, admin, or tracking
      allow read: if isSuperAdmin() || isSupportAgent() || (
        isAuthenticated() && (
          resource.data.customerId == request.auth.uid ||
          resource.data.driverId == request.auth.uid ||
          (isMerchant() && resource.data.storeId == getUserData().restaurantId)
        )
      ) || (resource.data.status != null);

      // Customer creates order: must be authenticated, cannot tamper with pricing
      allow create: if (
        isAuthenticated() &&
        request.resource.data.status in ["RECEIVED", "PLACED"] &&
        request.resource.data.total >= 0 &&
        request.resource.data.deliveryFee >= 0 &&
        (!('customerId' in request.resource.data) || request.resource.data.customerId == request.auth.uid)
      ) || isSuperAdmin();

      // Updates: Courier can update GPS, assignment, and delivery status; Merchant can update preparation; Admin can update all
      allow update: if isSuperAdmin() || isSupportAgent() || (
        isAuthenticated() && (
          // Courier accepting task and updating GPS location / delivery status
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'courierLat', 'courierLng', 'courierProgress', 'estimatedMinsLeft', 'status', 'updatedAt',
            'driverId', 'courierName', 'courierPhone', 'courierVehicle'
          ]) ||
          // Merchant updating order acceptance and kitchen prep
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'restaurantStatus', 'status', 'updatedAt'
          ]) ||
          // Customer rating or updating delivery notes or cancelling before preparation
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'hasReviewed', 'deliveryNotes', 'status', 'updatedAt'
          ])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // --- STORES & PRODUCTS COLLECTIONS ---
    match /stores/{storeId} {
      allow read: if true; // Public catalog browsing
      allow write: if isSuperAdmin() || (
        isMerchant() && resource.data.ownerId == request.auth.uid
      );
    }

    match /products/{productId} {
      allow read: if true; // Public menu browsing
      allow write: if isSuperAdmin() || isMerchant();
    }

    // --- REVIEWS & RATINGS ---
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isAuthenticated();
      allow create, update: if isSuperAdmin() || isSupportAgent();
      allow delete: if isSuperAdmin();
    }

    // --- SUPPORT TICKETS ---
    match /support_tickets/{ticketId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || isSupportAgent();
      allow delete: if isSuperAdmin();
    }
  }
}
