# ALLO AZIZ - Development & Production Environment Configuration
# Target Market: Morocco (Launch City: Mohammedia)
#
# NOTE FOR DEVELOPMENT / PREVIEW:
# All external third-party services (Google Maps, Payment Gateways, SMS OTP,
# Firebase, Cloud Storage) are 100% OPTIONAL. The app automatically runs in
# offline-first DEVELOPMENT MODE using local Room database, realistic demo
# data, and safe local fallbacks without requiring any API keys.
#
# To enable external cloud integrations for production, configure the keys below:
# ==============================================================================

# [OPTIONAL PRODUCTION INTEGRATIONS]
# GOOGLE_MAPS_API_KEY=
# PAYMENT_PROVIDER_KEY=
# PAYMENT_PROVIDER_SECRET=
# SMS_PROVIDER_KEY=
# EMAIL_PROVIDER_KEY=
# FIREBASE_PROJECT_ID=
# STORAGE_KEY=
